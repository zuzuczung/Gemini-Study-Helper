{
  "manifest_version": 3,
  "name": "Gemini Study Helper",
  "version": "0.5.1",
  "description": "Bôi đen câu hỏi một lần để tra cứu Gemini/Groq; bỏ bôi đen để ẩn đáp án.",
  "permissions": ["storage"],
  "host_permissions": ["https://generativelanguage.googleapis.com/*", "https://api.groq.com/*"],
  "background": {
    "service_worker": "src/background.js",
    "scripts": ["src/core.js", "src/documents.js", "src/background.js"]
  },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["src/core.js", "src/content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }],
  "action": {"default_title": "Cài đặt và trạng thái Gemini"},
  "options_ui": {"page": "options/options.html", "open_in_tab": true}
}
